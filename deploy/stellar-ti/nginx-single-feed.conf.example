# nginx http{} context include (e.g. /etc/nginx/conf.d/stellar-ti.conf)
# DESIGN ONLY: do not install before owner production/credential authorization.
# Replace invalid sample hostname, cert paths; customer identities are handled
# inside the loopback service. ONLY ONE public Custom TIP feed per customer.
limit_req_zone $binary_remote_addr zone=stellar_ti_customer:5m rate=30r/m;

server {
    listen 443 ssl;
    server_name ti.example.invalid;
    server_tokens off;

    ssl_certificate /etc/stellar-ti/tls/fullchain.pem;
    ssl_certificate_key /etc/stellar-ti/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;

    # App checks per-tenant Basic Authorization on every request.
    # Nginx never serves raw unsigned GitHub/CI artifacts.
    # No HTTP fallback, no bearer token in the query string.
    location ~ ^/v1/tenants/[a-z][a-z0-9-]{1,62}/feeds/stellar-ti\.tsv$ {
        limit_req zone=stellar_ti_customer burst=10 nodelay;
        limit_except GET { deny all; }
        proxy_pass http://127.0.0.1:18332;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection "";
        proxy_connect_timeout 3s;
        proxy_read_timeout 15s;
        proxy_send_timeout 5s;
        proxy_buffering off;
        proxy_cache off;
        add_header Cache-Control "no-store, max-age=0" always;
        add_header X-Content-Type-Options "nosniff" always;
    }
    # Health & metrics endpoints must never be reachable on the public edge.
    location ^~ /internal/ { return 404; }
    location / { return 404; }
}
