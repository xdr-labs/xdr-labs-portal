# AGENTIC HUNTING OPTIONAL: 14 noisy detections; never deploy as a standalone Stellar Cyber import.
# Historical IOCs, OAST, generic API endpoints, ordinary AI user agents require baseline verification.
# Source: ThreatDefence agentic-attack-detections (MIT), plus one locally authored norma/0.4 rule.
alert http any any -> any any (msg:"XDR HUNT ARTEX-associated norma web client user-agent non-unique"; flow:established,to_server; http.user_agent; content:"norma/0.4"; nocase; fast_pattern; classtype:misc-activity; sid:9876101; rev:1; metadata:confidence Low,framework ARTEX;)
alert http any any -> any 8888 (msg:"XDR HUNT HexStrike shell command API request"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"/api/command"; startswith; fast_pattern; classtype:attempted-admin; sid:9876102; rev:1; metadata:created_at 2026_11_21, confidence Medium, malware_family HexStrike;)
alert http any any -> any 8888 (msg:"XDR HUNT HexStrike tool API request"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"/api/tools/"; startswith; fast_pattern; classtype:attempted-admin; sid:9876103; rev:1; metadata:created_at 2026_11_21, confidence Medium, malware_family HexStrike;)
alert tcp $HOME_NET any -> $EXTERNAL_NET 28000:29999 (msg:"XDR HUNT Outbound connection to PentAGI worker port range 28000-29999"; flow:established,to_server; threshold:type limit, track by_src, count 1, seconds 3600; classtype:misc-activity; sid:9876104; rev:1; metadata:created_at 2026_11_21, confidence Low, malware_family PentAGI;)
alert dns $HOME_NET any -> any any (msg:"XDR HUNT PentAGI update service lookup"; dns.query; content:"update.pentagi.com"; nocase; endswith; fast_pattern; classtype:policy-violation; sid:9876105; rev:1; metadata:created_at 2026_11_21, confidence Medium, malware_family PentAGI;)
alert tls $HOME_NET any -> any any (msg:"XDR HUNT PentAGI update service in TLS SNI"; tls.sni; content:"update.pentagi.com"; nocase; endswith; fast_pattern; classtype:policy-violation; sid:9876106; rev:1; metadata:created_at 2026_11_21, confidence Medium, malware_family PentAGI;)
alert http any any -> $HTTP_SERVERS any (msg:"XDR HUNT Claude Code WebFetch user agent (AI agent page reader, Cairn workers, also legitimate use)"; flow:established,to_server; http.user_agent; content:"Claude-User (claude-code/"; fast_pattern; classtype:misc-activity; sid:9876107; rev:1; metadata:created_at 2026_11_21, confidence Low, malware_family Cairn;)
alert http any any -> $HTTP_SERVERS any (msg:"XDR HUNT Qwen Code user agent (AI agent page reader or search, also legitimate use)"; flow:established,to_server; http.user_agent; content:"QwenCode/"; startswith; fast_pattern; classtype:misc-activity; sid:9876108; rev:1; metadata:created_at 2026_11_21, confidence Low;)
alert dns $HOME_NET any -> any any (msg:"XDR HUNT Out-of-band testing domain lookup (interact.sh)"; dns.query; content:".interact.sh"; nocase; endswith; fast_pattern; classtype:web-application-attack; sid:9876109; rev:1; metadata:created_at 2026_11_21, confidence Medium;)
alert dns $HOME_NET any -> any any (msg:"XDR HUNT Out-of-band testing domain lookup (oast.fun)"; dns.query; content:".oast.fun"; nocase; endswith; fast_pattern; classtype:web-application-attack; sid:9876110; rev:1; metadata:created_at 2026_11_21, confidence Medium;)
alert dns $HOME_NET any -> any any (msg:"XDR HUNT Out-of-band testing domain lookup (burpcollaborator.net)"; dns.query; content:".burpcollaborator.net"; nocase; endswith; fast_pattern; classtype:web-application-attack; sid:9876111; rev:1; metadata:created_at 2026_11_21, confidence Medium;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"XDR HUNT WSUS admin or sync web service requested from external address"; flow:established,to_server; http.uri; pcre:"/\/(ApiRemoting30\/WebService|ServerSyncWebService\/ServerSyncWebService|ReportingWebService\/ReportingWebService)\.asmx/i"; classtype:attempted-admin; sid:9876112; rev:1; metadata:created_at 2026_11_21, confidence Medium;)
alert http $HOME_NET any -> any any (msg:"XDR HUNT Cairn anti-refusal task prompt in model request"; flow:established,to_server; http.request_body; content:"under no circumstances should you reject"; fast_pattern; content:"policy_refusal"; classtype:policy-violation; sid:9876113; rev:1; metadata:created_at 2026_11_21, confidence High, malware_family Cairn;)
alert dns $HOME_NET any -> any any (msg:"XDR HUNT ARTEX toolkit payload host lookup (vietnam852.com, zhzy999.net, jiancai008.com)"; dns.query; pcre:"/(^|\.)(vietnam852\.com|zhzy999\.net|jiancai008\.com)$/i"; classtype:trojan-activity; sid:9876114; rev:1; metadata:created_at 2026_11_20, confidence High, malware_family Gh0stRAT;)
