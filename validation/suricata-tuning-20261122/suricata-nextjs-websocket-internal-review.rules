# QA-ONLY, may alert on authorized metadata/loopback WebSocket proxy. Do not install without approval.
alert http any any -> any any (msg:"XDR QA WebSocket Upgrade to metadata or loopback URI (CVE-2026-44578 probe only)"; flow:established,to_server; http.method; content:"GET"; startswith; http.uri.raw; content:"http"; startswith; pcre:"/^https?:\/\/(?:169\.254\.169\.254|127\.0\.0\.1|localhost|metadata\.google\.internal)(?::[0-9]{1,5})?(?:\/|\?|$)/i"; http.header; to_lowercase; content:"upgrade|3a 20|websocket"; fast_pattern; content:"sec-websocket-version|3a 20|13"; content:"sec-websocket-key|3a 20|"; classtype:attempted-recon; sid:9005017; rev:2; metadata:confidence Medium, tag qa_review_only, cve CVE_2026_44578;)
